{
  "id": "M-CZ-001",
  "title": "科学计数法",
  "grade": "七年级",
  "task": "让学生掌握科学记数法的概念，会用科学记数法表示相关数据。",
  "reference_points": "导入（大数书写不便）→ 复习 10 的乘方 → 用乘方表示大数 → 辨析 A 的取值范围 → 给出定义 → 例 5 练习 → 小结",
  "checkpoints": [
    {
